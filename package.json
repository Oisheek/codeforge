{
    "name": "@oisheek_c/codeforge",
    "version": "1.0.3",
    "description": "Terminal-native AI software engineering agent",
    "license": "MIT",
    "type": "module",
    "files": [
        "bin",
        "apps/cli/src",
        "apps/cli/bin",
        "packages/agent/*.js",
        "packages/config/*.js",
        "packages/core/*.js",
        "packages/git/*.js",
        "packages/memory/*.js",
        "packages/prompts/*.js",
        "packages/providers/*.js",
        "packages/reasoning/*.js",
        "packages/retrieval/*.js",
        "packages/retrieval/parser/*.js",
        "packages/retrieval/parser/extractors/*.js",
        "packages/retrieval/parser/languages/*.js",
        "packages/retrieval/parser/queries/*.js",
        "packages/scanner/*.js",
        "packages/terminal/*.js",
        "packages/tools/*.js",
        "packages/utils/*.js",
        "LICENSE",
        "README.md"
    ],
    "engines": {
        "node": ">=22.13.0"
    },
    "packageManager": "pnpm@11.17.0",
    "scripts": {
        "dev": "pnpm --filter @codeforge/cli dev",
        "start": "node apps/cli/src/index.js",
        "test": "node --test"
    },
    "dependencies": {
        "@openrouter/sdk": "^1.1.14",
        "chalk": "^6.0.0",
        "commander": "^15.0.0",
        "dotenv": "^17.4.2",
        "openai": "^6.49.0",
        "ora": "^9.4.1",
        "simple-git": "^3.36.0",
        "tree-sitter": "^0.25.1",
        "tree-sitter-c": "^0.24.1",
        "tree-sitter-c-sharp": "^0.23.5",
        "tree-sitter-cpp": "^0.23.4",
        "tree-sitter-go": "^0.25.0",
        "tree-sitter-java": "^0.23.5",
        "tree-sitter-javascript": "^0.25.0",
        "tree-sitter-php": "^0.24.2",
        "tree-sitter-python": "^0.25.0",
        "tree-sitter-ruby": "^0.23.1",
        "tree-sitter-rust": "^0.24.0",
        "tree-sitter-swift": "^0.7.1",
        "tree-sitter-typescript": "^0.23.2",
        "zod": "^4.4.3"
    },
    "bin": {
        "codeforge": "bin/codeforge.js"
    }
}
